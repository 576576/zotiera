<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      系统启动画面只认清单里挂的主题，运行时的 setTheme 改不到它，
      所以这个主题跟随系统深浅色；Compose 画出第一帧之后的窗口底色由下面两个接管。
    -->
    <style name="Theme.Zotiera" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Compose 画出第一帧之前的窗口底色，MainActivity 按应用内的深浅色设置选一个 -->
    <style name="Theme.Zotiera.Light" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="Theme.Zotiera.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>
</resources>
